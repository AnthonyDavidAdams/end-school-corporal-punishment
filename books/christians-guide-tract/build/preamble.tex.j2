<% if cjk %>
% --- Chinese / Japanese / Korean text (book.yaml `cjk:`) ---
% xeCJK sets CJK runs in their own font and handles line breaking and
% punctuation; Latin letters, digits and URLs stay in the main font above.
% Chinese books indent every paragraph, including the first after a heading,
% by two characters, so `indentfirst` and a 2em indent replace the Latin
% conventions whatever `indent_in` says.
\usepackage{xeCJK}
\setCJKmainfont{<<cjk.main>>}[BoldFont={<<cjk.bold|default(cjk.main)>>}<% if cjk.italic %>, ItalicFont={<<cjk.italic>>}<% endif %>]
\setCJKsansfont{<<cjk.sans|default(cjk.main)>>}
\xeCJKsetup{PunctStyle=<<cjk.punct|default("quanjiao")>>, CJKmath=false}
\usepackage{indentfirst}
\usepackage{zhnumber}
\renewcommand{\thepart}{\zhnum{part}}
\renewcommand{\contentsname}{<<toc_title|default("目录")>>}
\renewcommand{\partname}{}
<% endif %>

% --- Body paragraph rules ---
<% if body.paragraph_style == "spaced" %>
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em plus 1pt minus 1pt}
<% else %>
<% if cjk %>\setlength{\parindent}{2em}<% else %>\setlength{\parindent}{<<indent_in>>in}<% endif %>
% A hair of stretch per paragraph. Invisible at reading size, but it gives
% \flushbottom somewhere to absorb slack instead of forcing loose pages.
\setlength{\parskip}{0pt plus 1.2pt}
<% endif %>
\linespread{<<body.line_spacing>>}
<% if not hyphenation %>\hyphenpenalty=10000\exhyphenpenalty=10000<% endif %>

% --- Layout priority (widows/orphans/balanced) ---
% NOTE: \raggedbottom and \needspace are incompatible. \needspace works by
% inserting a cheap breakpoint (\penalty -100) ahead of the heading; under
% \raggedbottom a short page carries no badness, so that -100 is cheaper than
% any later break and TeX takes it at EVERY heading — starting each section on
% a fresh page and stranding 6-13 blank lines on the page before, whether or
% not space was actually tight. \headNeedspace therefore expands to nothing
% whenever \raggedbottom is in force.
%
% Under \flushbottom the heading rule is memoir's EXACT \Needspace, not the
% approximate \needspace. \needspace carries `plus N\baselineskip` of stretch
% into its own breakpoint, so on a page of short items (a list under each of
% twelve headings) the page looks stretchable enough to end at every heading:
% a 108-entry summary list ran 12 pages instead of 8. \Needspace measures the
% room actually left and breaks only when the heading would be stranded.
<% if layout_priority == "widows_orphans" %>
\widowpenalty=10000
\clubpenalty=10000
\raggedbottom
\newcommand{\headNeedspace}[1]{}
<% elif layout_priority == "balanced" %>
\widowpenalty=150
\clubpenalty=150
\flushbottom
\newcommand{\headNeedspace}[1]{\Needspace{#1\baselineskip}}
<% else %>
\widowpenalty=1000
\clubpenalty=1000
\flushbottom
\newcommand{\headNeedspace}[1]{\Needspace{#1\baselineskip}}
<% endif %>

% --- Chapter title styling ---
% titlesec alignment macros: \filleft=right, \filcenter=centered, \filright=left
\usepackage{titlesec}
<% set align = chapter_title.align | default("left") %>
<% if align == "right" %><% set fill = "\\filleft" %>
<% elif align == "center" %><% set fill = "\\filcenter" %>
<% else %><% set fill = "\\filright" %>
<% endif %>
<% if chapter_number.show %>
  <% if chapter_number.format == "numeral" %>
\titleformat{\chapter}[display]
  {\normalfont<<fill>>}
  {\headingfont\fontsize{<<chapter_number.size_pt>>}{<<chapter_number.size_pt + 4>>}\selectfont\thechapter}
  {0.6em}
  {\headingfont\fontsize{<<chapter_title.size_pt>>}{<<chapter_title.size_pt + 6>>}\selectfont<% if chapter_title.bold %>\bfseries<% endif %><% if chapter_title.italic %>\itshape<% endif %><<fill>>}
  <% elif chapter_number.format == "chapter_n" %>
\titleformat{\chapter}[display]
  {\normalfont<<fill>>}
  {\headingfont\fontsize{<<chapter_number.size_pt>>}{<<chapter_number.size_pt + 4>>}\selectfont Chapter \thechapter}
  {0.6em}
  {\headingfont\fontsize{<<chapter_title.size_pt>>}{<<chapter_title.size_pt + 6>>}\selectfont<% if chapter_title.bold %>\bfseries<% endif %><% if chapter_title.italic %>\itshape<% endif %><<fill>>}
  <% endif %>
<% else %>
\titleformat{\chapter}[display]
  {\normalfont<<fill>>}
  {}
  {0pt}
  {\headingfont\fontsize{<<chapter_title.size_pt>>}{<<chapter_title.size_pt + 6>>}\selectfont<% if chapter_title.bold %>\bfseries<% endif %><% if chapter_title.italic %>\itshape<% endif %><<fill>>}
<% endif %>
\titlespacing*{\chapter}{0pt}{<<chapter_title.space_before_pt|default(60)>>pt}{<<chapter_title.space_after_pt|default(40)>>pt}

% --- Section title styling ---
% \needspace prevents hanging headers: if there isn't enough room for the
% heading + N lines of body below it on the current page, break to a new
% page so the heading stays with its content.
\usepackage{needspace}
\titleformat{\section}
  {\headNeedspace{4}\headingfont\large\bfseries}{}{0pt}{}
\titleformat{\subsection}
  {\headNeedspace{3}\headingfont\bfseries}{}{0pt}{}
\titleformat{\subsubsection}
  {\headNeedspace{3}\headingfont\bfseries\itshape}{}{0pt}{}
\titlespacing*{\section}{0pt}{14pt}{6pt}
\titlespacing*{\subsection}{0pt}{10pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{8pt}{2pt}

% Display-math widow penalty (e.g. blockquotes/displays at column edges)
\displaywidowpenalty=10000

% Stronger penalty against breaking inside a paragraph
\interlinepenalty=100

% Let TeX stretch interword space as a last resort instead of pushing an
% unbreakable token (a bold URL, a long cite) past the right margin. Without
% this, KDP's previewer rejects the file with "text is outside the margins".
\setlength{\emergencystretch}{3em}

% --- Running headers/footers ---
\makepagestyle{kdpheaders}
\makeevenhead{kdpheaders}{\thepage}{}{\fontsize{<<running_head.size_pt>>}{<<running_head.size_pt + 2>>}\selectfont\itshape <<author>>}
\makeoddhead{kdpheaders}{\fontsize{<<running_head.size_pt>>}{<<running_head.size_pt + 2>>}\selectfont\itshape <<title>>}{}{\thepage}
<% if footer_url %>
\makeevenfoot{kdpheaders}{}{\fontsize{8}{10}\selectfont\color{black!55}<<footer_url>>}{}
\makeoddfoot{kdpheaders}{}{\fontsize{8}{10}\selectfont\color{black!55}<<footer_url>>}{}
<% else %>
\makeevenfoot{kdpheaders}{}{}{}
\makeoddfoot{kdpheaders}{}{}{}
<% endif %>
\makeheadrule{kdpheaders}{\textwidth}{0pt}
