% --- Emblem: the seven interlocking rings of the Earth flag, drawn in TikZ so
% it stays vector at any size. `emblem: rings` in book.yaml turns it on; it
% then appears on the half-title and title pages, on part pages, as the
% chapter-end ornament and as the scene break. #1 = ring radius (a length).
<% if emblem == "rings" %>
\usepackage{tikz}
\newcommand{\ringsEmblem}[1]{%
  \begin{tikzpicture}[baseline=(current bounding box.center)]
    \pgfmathsetlengthmacro{\ringlw}{0.11*#1}
    \foreach \a in {0,60,...,300} {\draw[line width=\ringlw] (\a:#1) circle (#1);}
    \draw[line width=\ringlw] (0,0) circle (#1);
  \end{tikzpicture}}
% The ornament closes a chapter only when it fits beneath the last line. If
% the page is nearly full (or the text ended exactly at a page foot and we
% are already on a fresh page) it is dropped: an emblem alone on an
% otherwise empty page costs a sheet of paper and looks like a mistake.
\newcommand{\chapterEndOrnament}{\par
  \ifdim\pagetotal>0pt\relax
    \ifdim\dimexpr\pagegoal-\pagetotal\relax>5\baselineskip\relax
      \nopagebreak\vspace{1.6em}\begin{center}\ringsEmblem{4.2pt}\end{center}
    \fi
  \fi}
<% else %>
\newcommand{\chapterEndOrnament}{}
<% endif %>

% --- Scene break (asterism, or the emblem) ---
<% if scene_break == "emblem" and emblem == "rings" %>
\newcommand{\sceneBreak}{%
  \begin{center}\vspace{0.6em}\ringsEmblem{3pt}\vspace{0.6em}\end{center}}
<% else %>
\newcommand{\sceneBreak}{%
  \begin{center}\vspace{0.6em}{\large $\ast\ \ast\ \ast$}\vspace{0.6em}\end{center}}
<% endif %>

% --- Callout boxes ---
\usepackage{tcolorbox}
\tcbuselibrary{skins,breakable}
\newtcolorbox{calloutbox}[1][]{
  enhanced,
  colback=black!5,            % light gray background
  colframe=black,             % black border
  boxrule=0.8pt,
  arc=4pt,                    % slightly rounded corners
  left=12pt, right=12pt, top=10pt, bottom=10pt,
  fonttitle=\headingfont\bfseries,
  before skip=14pt, after skip=14pt,
  #1
}

% --- Chapter-end CTA box: text on the left, QR on the right ---
\newcommand{\ctaCallout}[2]{%
  % #1 = custom sentence (markdown body)
  % #2 = URL for QR + display
  \begin{calloutbox}
    \begin{minipage}[c]{0.65\linewidth}
      \itshape #1\par\vspace{6pt}
      \textbf{\headingfont\fontsize{10}{12}\selectfont #2}
    \end{minipage}\hfill
    \begin{minipage}[c]{0.28\linewidth}
      \centering
      \qrcode[height=0.95in]{https://#2}
    \end{minipage}
  \end{calloutbox}
}

% --- FREE GIFT box (Hormozi-style direct response) ---
% #1 = number, #2 = headline (caps), #3 = body LaTeX, #4 = URL
% Reserve enough vertical room so the box doesn't split across a page break.
% Measured at 10.5pt/1.35 with a 1.05in QR: the box is ~120pt plus 14pt of
% before/after skip = ~10.4 baselines. Over-reserving strands blank lines on
% the page before, so keep this just above the real height.
\newcommand{\hormoziCallout}[4]{%
  \needspace{12\baselineskip}%
  \begin{calloutbox}
    {\headingfont\bfseries\fontsize{10.5}{13}\selectfont FREE GIFT \##1: #2}\par
    \vspace{10pt}
    \begin{minipage}[c]{0.66\linewidth}
      \headingfont\fontsize{9.5}{13.5}\selectfont #3
    \end{minipage}\hfill
    \begin{minipage}[c]{0.27\linewidth}
      \centering
      \qrcode[height=1.1in]{https://#4}\par
      \vspace{4pt}
      \colorbox{black}{\color{white}\hspace{4pt}\fontsize{7.5}{9}\selectfont\headingfont\bfseries SCAN ME\hspace{4pt}\rule[-1.5pt]{0pt}{10pt}}
    \end{minipage}
  \end{calloutbox}
}

% --- QR codes ---
\usepackage{qrcode}
% Caption sits in a fixed-width minipage, NOT a `c` tabular cell: a `c` cell
% never line-breaks, so any caption longer than the text block silently runs
% off the page and KDP's previewer rejects the file as "text outside the
% margins".
\newcommand{\qrcallout}[2]{%
  \begin{center}
  \vspace{0.6em}
  \qrcode[height=1in]{#1}\\[0.55em]
  \begin{minipage}{0.84\linewidth}
    \centering\small\itshape #2
  \end{minipage}\\[0.4em]
  \begin{minipage}{0.84\linewidth}
    \centering\footnotesize\ttfamily\sloppy #1
  \end{minipage}
  \vspace{0.6em}
  \end{center}
}

