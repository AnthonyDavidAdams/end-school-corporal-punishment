          <script>
    function trackError(retries = 0) {
      // Enhanced referrer analysis
      var brokenUrl = window.location.pathname + window.location.search;
      var referrer = document.referrer || '(direct)';
      var referrerDomain = '(direct)';
      var referrerType = 'direct';
      
      if (referrer && referrer !== '') {
        try {
          var referrerUrl = new URL(referrer);
          referrerDomain = referrerUrl.hostname;
          
          // Categorize referrer types
          if (referrerDomain.includes('google.')) {
            referrerType = 'google_search';
          } else if (referrerDomain.includes('bing.') || referrerDomain.includes('yahoo.') || referrerDomain.includes('duckduckgo.')) {
            referrerType = 'other_search';
          } else if (referrerDomain.includes('facebook.') || referrerDomain.includes('twitter.') || referrerDomain.includes('linkedin.') || referrerDomain.includes('instagram.')) {
            referrerType = 'social_media';
          } else if (referrerDomain === window.location.hostname) {
            referrerType = 'internal';
          } else {
            referrerType = 'external_website';
          }
        } catch (e) {
          console.warn('Error parsing referrer URL:', e);
        }
      }
      
      // Check for Monster Insights first, then fallback to gtag
      if (typeof mi_track_event === "function") {
        mi_track_event('page_not_found', {
          'page_location': window.location.href,
          'page_path': brokenUrl,
          'page_referrer': referrer,
          'referrer_domain': referrerDomain,
          'referrer_type': referrerType,
          'event_category': 'Site Errors',
          'user_agent': navigator.userAgent.substring(0, 100),
          'timestamp': new Date().toISOString(),
          'value': 1
        });
        
        console.log('404 error tracked via Monster Insights:', {
          url: brokenUrl,
          referrer: referrer,
          domain: referrerDomain,
          type: referrerType
        });
      } else if (typeof gtag === "function" && typeof gtag.l !== 'undefined') {
        // GA4 exception tracking
        gtag('event', 'exception', {
          'description': '404_error',
          'fatal': false,
          'custom_map': {
            'broken_url': brokenUrl,
            'referrer': referrer,
            'referrer_domain': referrerDomain,
            'referrer_type': referrerType
          }
        });
        
        // Enhanced custom event for 404s with detailed referrer info
        gtag('event', '404_error', {
          'event_category': 'Site Errors',
          'event_label': brokenUrl,
          'referrer_domain': referrerDomain,
          'referrer_type': referrerType,
          'page_location': window.location.href,
          'page_referrer': referrer,
          'user_agent_brief': navigator.userAgent.substring(0, 100),
          'timestamp': new Date().toISOString()
        });
        
        console.log('404 error tracked via gtag:', {
          url: brokenUrl,
          referrer: referrer,
          domain: referrerDomain,
          type: referrerType
        });
      } else if (retries < 100) { // Increase to 10 seconds (100 * 100ms)
        setTimeout(() => trackError(retries + 1), 100);
      } else {
        console.warn('Neither Monster Insights nor gtag available for 404 tracking after 10 seconds');
      }
    }

    // Wait for window load to ensure all scripts are loaded
    function initTracking() {
      // Add a small delay to ensure analytics is fully initialized
      setTimeout(trackError, 500);
    }

    if (document.readyState === 'complete') {
      initTracking();
    } else {
      window.addEventListener('load', initTracking);
    }
  </script>
    
    
        
