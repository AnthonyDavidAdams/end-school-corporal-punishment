{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "District corporal punishment policies for one state",
  "type": "object",
  "required": [
    "state",
    "districts"
  ],
  "properties": {
    "state": {
      "type": "string",
      "pattern": "^[A-Z]{2}$"
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "county": {
            "type": [
              "string",
              "null"
            ]
          },
          "nces_id": {
            "type": [
              "string",
              "null"
            ],
            "pattern": "^[0-9]{7}$",
            "description": "NCES LEA ID, 7 digits"
          },
          "status": {
            "enum": [
              "allows",
              "bans",
              "consent_required",
              "silent",
              "unknown"
            ]
          },
          "source": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "URL of the board policy, handbook, or official record that establishes the status"
          },
          "quote": {
            "type": [
              "string",
              "null"
            ],
            "description": "Verbatim sentence from the source that establishes the status"
          },
          "policy_code": {
            "type": [
              "string",
              "null"
            ],
            "description": "Board policy number, e.g. 'JDA' or 'FO(LOCAL)'"
          },
          "crdc_students_latest": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Students receiving CP in the latest CRDC year"
          },
          "last_verified": {
            "type": [
              "string",
              "null"
            ],
            "format": "date"
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          },
          "phone_policy": {
            "type": [
              "object",
              "null"
            ],
            "description": "Student cell phone rule from the handbook or board policy: bell_to_bell_ban = phones off and stored for the whole school day; classroom_ban = prohibited during instruction, allowed at lunch/passing; teacher_discretion = each teacher decides; allowed = generally permitted with limits; unknown = no policy sentence found",
            "properties": {
              "status": {
                "enum": [
                  "bell_to_bell_ban",
                  "classroom_ban",
                  "teacher_discretion",
                  "allowed",
                  "unknown"
                ]
              },
              "quote": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "policy_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_verified": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "ai_policy": {
            "type": [
              "object",
              "null"
            ],
            "description": "Generative AI rule: prohibited = students may not use AI tools for schoolwork; permitted_with_guidance = allowed when the teacher or assignment permits, with a stated policy; academic_integrity_only = mentioned only inside the cheating/plagiarism rule; no_policy = handbook was read in full and says nothing; unknown = could not determine",
            "properties": {
              "status": {
                "enum": [
                  "prohibited",
                  "permitted_with_guidance",
                  "academic_integrity_only",
                  "no_policy",
                  "unknown"
                ]
              },
              "quote": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri"
              },
              "policy_code": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "last_verified": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "archived_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "description": "Wayback Machine capture of `source`, taken at scan time"
          },
          "document_text_path": {
            "type": [
              "string",
              "null"
            ],
            "description": "Path in this repo to the extracted text of the discipline section, e.g. data/policies/AL/0100540.md"
          },
          "start_times": {
            "type": [
              "object",
              "null"
            ],
            "description": "Bell schedule for the district's secondary schools. Adolescent sleep research and the AAP recommend secondary schools start no earlier than 8:30.",
            "properties": {
              "high_school": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "start": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "First bell / start of instruction, local time, e.g. '7:45'"
                  },
                  "end": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "school": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "quote": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "middle_school": {
                "type": [
                  "object",
                  "null"
                ],
                "properties": {
                  "start": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "First bell / start of instruction, local time, e.g. '7:45'"
                  },
                  "end": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "school": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "source": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "format": "uri"
                  },
                  "quote": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              },
              "last_verified": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "date"
              },
              "notes": {
                "type": [
                  "string",
                  "null"
                ]
              }
            }
          },
          "legacy_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "allows",
              "bans",
              "consent_required",
              null
            ],
            "description": "A status carried over from the pre-2026 map that was never sourced. Kept only to prioritise re-scanning; never published as fact."
          },
          "contact": {
            "type": [
              "object",
              "null"
            ],
            "description": "Official published contact for the district, taken from the district's own website while scanning its policy. Public record only: the general/superintendent office, the board clerk, the address and phone a member of the public is invited to use. Never a personal address, never a scraped social account, never an individual staff member who is not the published point of contact.",
            "additionalProperties": false,
            "properties": {
              "district_email": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "General or superintendent's office email as published"
              },
              "board_email": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Board or board clerk email as published"
              },
              "phone": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "mailing_address": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "superintendent": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Name as published"
              },
              "board_page": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "URL of the board page listing members and meeting times"
              },
              "contact_page": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "URL the contact was read from, so it can be rechecked"
              },
              "public_comment": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "How the public signs up to speak at a board meeting, if published"
              },
              "as_of": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Date read (YYYY-MM-DD), or the school year of the federal file the contact came from (e.g. 2023-24)"
              },
              "website": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "District's own website as published in the federal LEA directory or on the district's site"
              },
              "source": {
                "type": [
                  "string",
                  "null"
                ],
                "format": "uri",
                "description": "Where this contact block was read: a district page, or the federal LEA directory file it came out of"
              },
              "contact_source": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Where the contact came from when not the district's own site: the state education agency's published directory, dated."
              }
            }
          },
          "policy_adopted": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date the corporal punishment policy was originally adopted, as the policy itself prints it (YYYY-MM-DD). The policy's own date, not the date we read it and not the handbook's publication date."
          },
          "policy_revised": {
            "type": [
              "string",
              "null"
            ],
            "description": "Date the corporal punishment policy was last revised or reissued, as the policy itself prints it (YYYY-MM-DD). For TASB this is the LOCAL section's DATE ISSUED."
          },
          "policy_dates_from": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "policy",
              "notes",
              null
            ],
            "description": "Where policy_adopted/policy_revised came from: 'policy' means a contributor read them off the policy, 'notes' means they were extracted from an existing note by tools/dates/extract.mjs and are weaker evidence."
          },
          "documents": {
            "type": [
              "array",
              "null"
            ],
            "description": "Every document read for this district, and what each one says. No single document is authoritative everywhere: in Texas the board policy permits or prohibits and the Student Code of Conduct decides whether a parent opts in or out; in Mississippi the board policy carries the whole rule and the handbook may not mention it at all. `status`, `source` and `quote` remain the settled answer for the district; this is the evidence behind it, and where two documents disagree that disagreement is a finding rather than an error.",
            "items": {
              "type": "object",
              "required": [
                "kind",
                "url"
              ],
              "properties": {
                "kind": {
                  "type": "string",
                  "enum": [
                    "board_policy",
                    "code_of_conduct",
                    "handbook",
                    "other"
                  ],
                  "description": "What kind of document this is"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                },
                "archived_url": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "uri",
                  "description": "Wayback capture, and the only source when a district's own site is behind a bot challenge"
                },
                "policy_code": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "e.g. FO(LOCAL), JDB"
                },
                "says": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "allows",
                    "bans",
                    "consent_required",
                    "silent",
                    null
                  ],
                  "description": "What THIS document establishes, which may differ from the district's settled status"
                },
                "quote": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Verbatim sentence from this document"
                },
                "confidence": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1,
                  "description": "Classifier confidence, where a machine read it"
                },
                "retrieved": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "ISO date this document was read"
                },
                "by": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "description": "Who or what read it"
                },
                "parent_control": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "enum": [
                    "opt_out",
                    "opt_in",
                    "none",
                    "unknown",
                    null
                  ],
                  "description": "What this document says about a parent's say"
                }
              },
              "additionalProperties": false
            }
          },
          "parent_control": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "opt_out",
              "opt_in",
              "none",
              "unknown",
              null
            ],
            "description": "What say a parent has, which `status` alone does not capture. `opt_out`: permitted by default, a parent may refuse it in writing. `opt_in`: not used unless a parent agrees first (the same districts as status consent_required). `none`: permitted and a parent CANNOT prevent it -- the district may strike a child over a parent's objection, which is materially worse than opt-out and was previously indistinguishable from it. `unknown`: the document read does not say, which is common because the mechanics often live in a different document from the permission."
          },
          "method": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "vendor_model_policy",
              "vendor_manual",
              "searched_document",
              "agent_via_crew",
              null
            ],
            "description": "What produced this record. vendor_model_policy: a state association's model policy the board adopted, read from the vendor (TASB) -- one of a handful of model sentences, so the board's choice is the finding. vendor_manual: the district's own manual on a policy vendor (Simbli, BoardDocs), read by code. searched_document: a handbook or policy located by search or site walk and machine-read. agent_via_crew: a contributor's frontier agent read it and submitted through the crew server, then the deterministic verifier and a review. None of these is a person reading a document by hand; the record has never had one."
          },
          "county_source": {
            "type": [
              "string",
              "null"
            ],
            "description": "Where the county came from when the record did not say: nces_edge_geocode_2023_24 = county of the district office from the federal geocode file."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "allows",
                    "bans",
                    "consent_required"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "required": [
                "source",
                "quote",
                "last_verified"
              ],
              "properties": {
                "source": {
                  "type": "string",
                  "format": "uri"
                },
                "quote": {
                  "type": "string",
                  "minLength": 10
                }
              }
            }
          }
        ]
      }
    }
  }
}
