#!/usr/bin/env python3
"""A stand-in for macOS osascript on the always-on host.

tools/outreach/run.py (text_anthony) and tools/social/recap.py reach Anthony with
    osascript -e 'tell application "Messages" to send "<json string>" to buddy "<number>" ...'
On Linux there is no Messages app. This shim finds the quoted message in the AppleScript and hands it to
notify.py, which routes it by ESCP_NOTIFY (smtp or webhook here). The recap's second statement, which sends a
still image as a POSIX file, is ignored. Anything that is not a Messages send is a no-op with exit 0, so the
pipeline never fails because an AppleScript could not run.
"""
import json
import os
import re
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))

script = ""
args = sys.argv[1:]
for i, a in enumerate(args):
    if a == "-e" and i + 1 < len(args):
        script += args[i + 1] + "\n"
if not script and args and os.path.exists(args[-1]):
    script = open(args[-1]).read()
if not script and not sys.stdin.isatty():
    script = sys.stdin.read()

m = re.search(r'send\s+("(?:[^"\\]|\\.)*")\s+to\b', script)
if not m or "Messages" not in script:
    sys.exit(0)
try:
    text = json.loads(m.group(1))
except ValueError:
    text = m.group(1).strip('"')
import notify
print("osascript shim ->", notify.send(text))
