<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.earthpilot.escp-nightly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>$HOME/end-school-corporal-punishment/tools/nightly/run-jev.sh</string>
  </array>
  <!-- 2am local. The run takes roughly an hour for 60 districts and nothing else is competing for
       the vendor rate limits at that hour. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/tmp/escp-nightly.out</string>
  <key>StandardErrorPath</key><string>/tmp/escp-nightly.err</string>
  <key>RunAtLoad</key><false/>
</dict>
</plist>
