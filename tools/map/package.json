{
  "name": "cp-map-builder",
  "private": true,
  "type": "module",
  "description": "Rebuilds site/assets/us-map.svg and site/data/districts/* from public-domain US Census boundaries.",
  "scripts": {
    "build": "node build-map.mjs ../../site/assets/us-map.svg ../../site/assets/us-states.svg ../../site/assets/state-centroids.json",
    "build-districts": "node build-districts.mjs /tmp/sd/cb_2024_us_unsd_500k.shp /tmp/sd/cb_2024_us_unsd_500k.dbf ../../site/data/districts"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "shapefile": "^0.6.6",
    "topojson-client": "^3.1.0",
    "topojson-server": "^3.0.1",
    "topojson-simplify": "^3.0.3",
    "us-atlas": "^3.0.1"
  }
}