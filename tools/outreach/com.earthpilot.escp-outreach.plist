<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.earthpilot.escp-outreach</string>
  <key>ProgramArguments</key><array><string>/bin/zsh</string><string>-lc</string><string>cd $HOME/end-school-corporal-punishment && /opt/homebrew/bin/python3 tools/outreach/run.py cycle</string></array>
